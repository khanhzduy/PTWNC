<!-- ========================================== -->
<!-- TRANG 7: CHƯƠNG 3 (GIỎ HÀNG & VOUCHER)     -->
<!-- ========================================== -->
<h3>3.3 Hệ sinh thái Giỏ hàng thời gian thực AJAX (Real-time Shopping Cart)</h3>
<p>
    Khắc phục hoàn toàn nhược điểm cố hữu của các bài tập lớn cũ (người dùng bấm tăng số lượng nhưng không bấm nút cập nhật dẫn đến tổng tiền không thay đổi). Hệ thống triển khai kiến trúc giỏ hàng 2 chiều:
</p>
<ul>
    <li><strong>Bộ điều khiển tăng giảm số lượng</strong>: Cung cấp 2 nút <strong>`[-]`</strong> và <strong>`[+]`</strong> kèm ô nhập số.</li>
    <li><strong>Tự động nhân tiền thời gian thực trên giao diện</strong>:
        $$\text{Thành tiền từng sách} = \text{Số lượng} \times \text{Đơn giá}$$
        $$\text{Tạm tính} = \sum (\text{Thành tiền}); \quad \text{Tổng thanh toán} = \text{Tạm tính} - \text{Giảm giá Voucher}$$
        Giao diện cập nhật số tiền ngay lập tức sau 1 mili-giây, loại bỏ hoàn toàn tình trạng lệch tiền.</li>
    <li><strong>Đồng bộ ngầm không tải lại trang (AJAX Sync)</strong>: API <code>POST /GioHang/CapNhatSoLuongAjax</code> cập nhật danh sách <code>CartItem</code> trong Session máy chủ sau 150ms kể từ lần bấm cuối cùng, bảo đảm phiên làm việc luôn khớp với giao diện.</li>
</ul>

<div class="code-box">
// Xử lý cập nhật số lượng và tính toán lại chiết khấu tức thì qua AJAX:
[HttpPost]
public IActionResult CapNhatSoLuongAjax(int ms, int soLuong) {
    var cart = GetCart();
    var item = cart.FirstOrDefault(c => c.Ms == ms);
    if (item != null) {
        item.SoLuong = Math.Clamp(soLuong, 1, 99);
        SaveCart(cart);
    }
    var subtotal = cart.Sum(c => c.ThanhTien);
    var discount = CalculateDiscount(GetVoucher(), subtotal);
    return Json(new { success = true, tamTinh = subtotal, giamGia = discount, tongThanhToan = subtotal - discount });
}
</div>

