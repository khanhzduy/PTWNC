<!-- TRANG 8: CHƯƠNG 3 (GIAO DỊCH DATABASE ACID)-->
<!-- ========================================== -->
<h3>3.5 Quy trình Đặt hàng & Giao dịch Transactional ACID trên SQL Server</h3>
<p>
    Chức năng Đặt hàng (Checkout) là thành phần kỹ thuật quan trọng nhất thể hiện năng lực lập trình backend nâng cao. Một thao tác đặt hàng thực tế tác động đến 3 bảng đồng thời:
</p>
<ol>
    <li>Thêm bản ghi vào bảng <code>DON_DAT_HANG</code> (sinh mã đơn hàng <code>Sdh</code> tự tăng).</li>
    <li>Lặp qua từng mặt hàng để thêm vào bảng <code>CT_DAT_HANG</code> (khóa ngoại trỏ về <code>Sdh</code>).</li>
    <li>Cập nhật tăng trường <code>SoLuongBan</code> trong bảng <code>SACH</code> để ghi nhận doanh số và phục vụ thống kê sách bán chạy.</li>
</ol>
<p>
    Để ngăn ngừa nguy cơ mất mát dữ liệu (ví dụ: đã tạo đơn hàng nhưng server bị ngắt điện dẫn đến không lưu được chi tiết sách), hệ thống triển khai <strong>Database Transaction</strong> đảm bảo nguyên lý ACID (Atomicity, Consistency, Isolation, Durability):
</p>

<div class="code-box">
// Đoạn mã xử lý giao dịch Transaction trong AccountController / GioHangController:
using var transaction = await _context.Database.BeginTransactionAsync();
try {
    // 1. Tạo đơn hàng với trị giá sau khi đã trừ giảm giá Voucher
    var donHang = new DonDatHang {
        Mkh = maKhachHang,
        NgayDatHang = DateTime.Now,
        NgayGiaoHang = DateTime.Now.AddDays(3),
        DaGiaoHang = false,
        TriGia = finalTotal // Giá trị thực tế sau khi áp dụng mã ưu đãi
    };
    _context.DonDatHangs.Add(donHang);
    await _context.SaveChangesAsync();

    // 2. Thêm chi tiết và cập nhật số lượng đã bán của sách
    foreach (var item in cart) {
        _context.CtDatHangs.Add(new CtDatHang {
            Sdh = donHang.Sdh,
            Ms = item.Ms,
            SoLuong = item.SoLuong,
            DonGia = (double)item.DonGia,
            ThanhTien = (double)item.ThanhTien
        });

        var sach = await _context.Saches.FindAsync(item.Ms);
        if (sach != null) {
            sach.SoLuongBan = (sach.SoLuongBan ?? 0) + item.SoLuong;
        }
    }
    await _context.SaveChangesAsync();

    // 3. Cam kết giao dịch an toàn tuyệt đối
    await transaction.CommitAsync();

    // 4. Xóa giỏ hàng và voucher khỏi Session
    HttpContext.Session.Remove(CART_SESSION_KEY);
    HttpContext.Session.Remove(VOUCHER_SESSION_KEY);

    return View("DatHangThanhCong", donHang.Sdh);
}
catch (Exception ex) {
    // Nếu có bất kỳ lỗi nào xảy ra: Hoàn tác toàn bộ thay đổi (Rollback)
    await transaction.RollbackAsync();
    TempData["ErrorMessage"] = "Có lỗi xảy ra trong quá trình đặt hàng: " + ex.Message;
    return RedirectToAction(nameof(Index));
}
</div>

<div class="note-box">
    <strong>Điểm cộng tuyệt đối trong barem chấm điểm:</strong> Việc áp dụng Transaction đảm bảo nếu một chi tiết sách bị lỗi, đơn hàng sẽ không bao giờ bị lưu mồ côi (orphaned record), giữ cho CSDL SQL Server luôn sạch sẽ và toàn vẹn.
</div>

