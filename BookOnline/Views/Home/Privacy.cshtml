@{
    ViewData["Title"] = "Giới thiệu về Nhà sách Book Online";
}

<div class="card shadow-sm border-0 mb-4 bg-white p-4">
    <!-- TIÊU ĐỀ CHÍNH -->
    <div class="border-bottom pb-3 mb-4 text-center">
        <h3 class="fw-bold text-success mb-2">
            <i class="bi bi-book-half me-2"></i> GIỚI THIỆU VỀ NHÀ SÁCH TRỰC TUYẾN BOOK ONLINE
        </h3>
        <p class="text-muted fs-6 mb-0">Hệ thống phân phối sách & tài liệu học tập chính thống của Trường Đại học Công nghiệp Việt - Hung</p>
    </div>

    <!-- 1. THÔNG TIN CHUNG & SỨ MỆNH -->
    <div class="row align-items-center mb-4 g-4">
        <div class="col-md-5 text-center">
            <img src="/images/Nen_banner.jpg" alt="Nhà sách ĐHCN Việt - Hung" class="img-fluid rounded shadow-sm border" onerror="this.src='/images/Upload/Sample.jpg'" />
        </div>
        <div class="col-md-7">
            <h5 class="fw-bold text-dark border-start border-4 border-success ps-2 mb-3">
                Sứ Mệnh Phát Triển & Phục Vụ Tri Thức
            </h5>
            <p class="text-secondary" style="line-height: 1.8;">
                <strong>Book Online</strong> được thành lập nhằm đáp ứng nhu cầu nghiên cứu, giảng dạy và học tập của cán bộ giảng viên, sinh viên trong và ngoài trường. Chúng tôi tự hào là cầu nối tri thức, mang đến hàng nghìn đầu sách chất lượng thuộc đa dạng các chuyên ngành: <em>Công nghệ thông tin, Kinh tế, Ngoại ngữ, Khoa học cơ bản, Khoa học kỹ thuật và Văn học</em>.
            </p>
            <p class="text-secondary mb-0" style="line-height: 1.8;">
                Website áp dụng các công nghệ lập trình Web tiên tiến trên nền tảng <strong>ASP.NET Core MVC</strong>, giúp bạn đọc tra cứu tài nguyên nhanh chóng, đặt sách thuận tiện và an toàn mọi lúc, mọi nơi.
            </p>
        </div>
    </div>

    <!-- 2. CAM KẾT VÀNG TỪ BOOK ONLINE -->
    <div class="mb-4">
        <h5 class="fw-bold text-dark border-start border-4 border-danger ps-2 mb-3">
            Cam Kết Dịch Vụ Của Chúng Tôi
        </h5>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="p-3 border rounded bg-light h-100 text-center">
                    <i class="bi bi-shield-check text-success fs-1 mb-2 d-block"></i>
                    <h6 class="fw-bold text-dark">100% Sách Thật - Chính Hãng</h6>
                    <p class="small text-muted mb-0">Liên kết trực tiếp với các Nhà xuất bản uy tín: NXB Trẻ, NXB Giáo Dục, NXB Thống Kê, Fahasa...</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 border rounded bg-light h-100 text-center">
                    <i class="bi bi-truck text-primary fs-1 mb-2 d-block"></i>
                    <h6 class="fw-bold text-dark">Giao Hàng Nhanh Toàn Quốc</h6>
                    <p class="small text-muted mb-0">Hỗ trợ đóng gói cẩn thận, thời gian giao hàng dự kiến chỉ từ 2 đến 3 ngày làm việc.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 border rounded bg-light h-100 text-center">
                    <i class="bi bi-arrow-repeat text-danger fs-1 mb-2 d-block"></i>
                    <h6 class="fw-bold text-dark">Đổi Trả Trong 7 Ngày</h6>
                    <p class="small text-muted mb-0">Chính sách hỗ trợ 1 đổi 1 miễn phí nếu sách gặp lỗi in ấn, thiếu trang hoặc hư hại trong quá trình vận chuyển.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. THÔNG TIN LIÊN HỆ CHÍNH THỨC -->
    <div class="bg-light p-4 rounded border">
        <h5 class="fw-bold text-success mb-3">
            <i class="bi bi-geo-alt-fill me-2"></i> THÔNG TIN LIÊN HỆ & ĐỊA CHỈ TRỤ SỞ
        </h5>
        <div class="row g-3">
            <div class="col-md-6">
                <ul class="list-unstyled mb-0 text-secondary" style="line-height: 2;">
                    <li><strong>Đơn vị:</strong> Nhà sách trường Đại học Công nghiệp Việt - Hung</li>
                    <li><strong>Khoa phụ trách:</strong> Khoa Công nghệ Thông tin</li>
                    <li><strong>Địa chỉ:</strong> 16 Xuân Khanh, Thị xã Sơn Tây, TP. Hà Nội</li>
                </ul>
            </div>
            <div class="col-md-6">
                <ul class="list-unstyled mb-0 text-secondary" style="line-height: 2;">
                    <li><strong>Điện thoại liên hệ:</strong> <span class="text-danger fw-bold">0983308081</span></li>
                    <li><strong>Thời gian làm việc:</strong> 07:30 - 17:30 (Thứ 2 đến Thứ 7)</li>
                    <li><strong>Hỗ trợ kỹ thuật:</strong> banhang@bookonline.viu.edu.vn</li>
                </ul>
            </div>
        </div>
    </div>
</div>
