@model int
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="card shadow-sm border-0 mb-4 bg-white p-5 text-center">
    <div class="mb-3 text-success">
        <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
    </div>
    <h3 class="fw-bold text-success mb-2">ĐẶT HÀNG THÀNH CÔNG!</h3>
    <p class="text-secondary fs-5 mb-4">
        Cảm ơn quý khách đã mua sắm tại Nhà sách trường Đại học Công nghiệp Việt - Hung.<br />
        Mã đơn hàng của bạn là: <strong class="text-danger fs-4">#@Model</strong>
    </p>

    <div class="alert alert-light border mx-auto text-start p-4" style="max-width: 500px;">
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-info-circle text-primary me-2"></i>
            <span>Đơn hàng đã được lưu thành công vào CSDL.</span>
        </div>
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-truck text-success me-2"></i>
            <span>Dự kiến giao hàng trong vòng 3 ngày làm việc.</span>
        </div>
        <div class="d-flex align-items-center">
            <i class="bi bi-telephone text-info me-2"></i>
            <span>Hotline hỗ trợ: <strong>0983308081</strong></span>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-success btn-lg px-4 me-2">
            <i class="bi bi-house-door-fill me-1"></i> Trở về Trang chủ
        </a>
        <a asp-controller="Sach" asp-action="SachMoi" class="btn btn-outline-primary btn-lg px-4">
            <i class="bi bi-book-half me-1"></i> Xem tiếp sách mới
        </a>
    </div>
</div>
