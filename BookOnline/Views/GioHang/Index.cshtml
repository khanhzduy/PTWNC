@model List<BookOnline.ViewModels.CartItem>
@{
    ViewData["Title"] = "Chi tiết Giỏ hàng";
    var tamTinh = Model.Sum(x => x.ThanhTien);
    var tongSoLuong = Model.Sum(x => x.SoLuong);
}

<div class="card shadow-sm border-0 mb-4 bg-white p-4" style="border-radius: 12px; border: 1px solid var(--pn-border);">
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <h4 class="fw-bold mb-0" style="color: var(--pn-blue) !important;">
            <i class="bi bi-bag-check-fill me-2 text-warning"></i> CHI TIẾT GIỎ HÀNG CỦA BẠN
        </h4>
        <span class="badge bg-light text-primary border rounded-pill px-3 py-2 fw-semibold" id="cartBadgeQty">
            Có <strong id="header-qty">@tongSoLuong</strong> sản phẩm
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- BẢNG GRID VIEW CHI TIẾT GIỎ HÀNG (THEO CHUẨN ĐẶC TẢ ĐỀ BÀI) -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0" id="cartTable">
                <thead class="text-white text-center" style="background-color: var(--pn-blue);">
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th style="width: 80px;">Hình ảnh</th>
                        <th>Tên sách</th>
                        <th style="width: 125px;">Đơn giá</th>
                        <th style="width: 170px;">Số lượng</th>
                        <th style="width: 140px;">Thành tiền</th>
                        <th style="width: 70px;">Hủy</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var item in Model)
                    {
                        <tr id="cart-row-@item.Ms" data-ms="@item.Ms">
                            <td class="text-center fw-semibold text-muted">@(stt++)</td>
                            <td class="text-center p-1">
                                <img src="@item.ImageUrl" alt="@item.TenSach" class="rounded border shadow-sm" style="width: 58px; height: 80px; object-fit: fill;" onerror="this.src='/images/Upload/Sample.jpg'" />
                            </td>
                            <td>
                                <a asp-controller="Sach" asp-action="Details" asp-route-id="@item.Ms" class="text-decoration-none fw-semibold text-dark hover-primary">
                                    @item.TenSach
                                </a>
                            </td>
                            <td class="text-end text-muted fw-semibold">
                                <span class="item-dongia" data-price="@item.DonGia">@item.DonGia.ToString("#,##0")</span> đ
                            </td>
                            <td>
                                <!-- KHỐI ĐIỀU CHỈNH SỐ LƯỢNG: CÓ NÚT + VÀ - CÙNG TÍNH TIỀN TỰ ĐỘNG -->
                                <form asp-action="CapNhatSoLuong" method="post" class="cart-qty-form d-flex align-items-center justify-content-center m-0" data-ms="@item.Ms">
                                    <input type="hidden" name="ms" value="@item.Ms" />
                                    <div class="input-group input-group-sm" style="width: 120px;">
                                        <button type="button" class="btn btn-outline-secondary px-2 btn-qty-minus" data-ms="@item.Ms" title="Giảm 1 cuốn">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input type="number" name="soLuong" value="@item.SoLuong" min="1" max="99" 
                                               class="form-control text-center fw-bold input-cart-qty px-1" 
                                               data-ms="@item.Ms" 
                                               data-dongia="@item.DonGia" 
                                               title="Nhập số lượng mua" />
                                        <button type="button" class="btn btn-outline-secondary px-2 btn-qty-plus" data-ms="@item.Ms" title="Tăng 1 cuốn">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-outline-primary ms-1 d-none btn-qty-submit" title="Cập nhật">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-end fw-bold text-danger fs-6">
                                <span class="item-thanhtien" id="thanhtien-@item.Ms">@item.ThanhTien.ToString("#,##0")</span> đ
                            </td>
                            <td class="text-center">
                                <form asp-action="XoaItem" method="post" class="m-0">
                                    <input type="hidden" name="ms" value="@item.Ms" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn hủy sách &quot;@item.TenSach&quot; khỏi giỏ hàng?');" title="Hủy sản phẩm">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- HÀNG THAO TÁC TIẾP TỤC & LÀM TRỐNG GIỎ -->
        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-bottom pb-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn mua thêm sách
            </a>
            <form asp-action="XoaTatCa" method="post" class="m-0">
                <button type="submit" class="btn btn-outline-warning text-dark rounded-pill px-3 btn-sm" onclick="return confirm('Bạn có chắc muốn xóa sạch toàn bộ sách trong giỏ hàng?');">
                    <i class="bi bi-x-circle me-1"></i> Xóa toàn bộ giỏ hàng
                </button>
            </form>
        </div>

        <!-- KHU VỰC TỔNG KẾT HÓA ĐƠN & NÚT TIẾN HÀNH ĐẶT HÀNG -->
        <div class="row justify-content-end mt-3">
            <div class="col-lg-5 col-md-7">
                <div class="card border p-3 bg-white shadow-sm" style="border-radius: 10px;">
                    <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">
                        <i class="bi bi-receipt text-primary me-1"></i> TỔNG KẾT THANH TOÁN
                    </h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tổng số lượng sách:</span>
                        <span class="fw-bold text-dark fs-6"><span id="summary-total-qty">@tongSoLuong</span> cuốn</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pt-2 border-top">
                        <span class="fw-bold fs-5 text-dark">TỔNG CỘNG TIỀN:</span>
                        <span class="fw-bold fs-4 text-danger" id="summary-tongthanhtoan">@tamTinh.ToString("#,##0") VNĐ</span>
                    </div>

                    <!-- FORM XÁC NHẬN TIẾN HÀNH ĐẶT HÀNG -->
                    <form asp-action="DatHang" method="post" id="formDatHang">
                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm rounded-pill btn-lg d-flex align-items-center justify-content-center gap-2" 
                                style="background-color: var(--pn-blue); border-color: var(--pn-blue);" 
                                id="btnDatHang"
                                data-final-total="@tamTinh">
                            <i class="bi bi-credit-card-fill text-warning fs-5"></i>
                            <span>TIẾN HÀNH ĐẶT HÀNG</span>
                        </button>
                    </form>
                    <div class="text-center mt-2">
                        <span class="text-muted small">
                            <i class="bi bi-shield-lock-fill text-success me-1"></i> Đơn hàng được bảo mật và lưu vào CSDL an toàn
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- GIỎ HÀNG TRỐNG -->
        <div class="text-center py-5">
            <img src="/images/Giohang.gif" alt="Giỏ hàng trống" style="height: 60px;" class="mb-3 opacity-50" />
            <h5 class="text-muted mb-3">Giỏ hàng của bạn đang trống!</h5>
            <p class="text-secondary small mb-4">Hãy dạo quanh các kệ sách phong phú và chọn những cuốn sách bạn yêu thích.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4" style="background-color: var(--pn-blue); border-color: var(--pn-blue);">
                <i class="bi bi-cart-plus me-1"></i> Mua sắm sách ngay
            </a>
        </div>
    }
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    // 1. HÀM ĐỊNH DẠNG TIỀN TỆ VIỆT NAM (16000 -> 16.000)
    function formatMoney(amount) {
        return Math.round(amount).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    // 2. HÀM CẬP NHẬT TỔNG TIỀN VÀ GIAO DIỆN CLIENT-SIDE NGAY LẬP TỨC
    function updateCartTotals() {
        let totalQty = 0;
        let subtotal = 0;

        document.querySelectorAll("#cartTable tbody tr").forEach(function (row) {
            const qtyInput = row.querySelector(".input-cart-qty");
            const priceSpan = row.querySelector(".item-dongia");
            const thanhTienSpan = row.querySelector(".item-thanhtien");

            if (qtyInput && priceSpan && thanhTienSpan) {
                const qty = parseInt(qtyInput.value) || 1;
                const price = parseFloat(priceSpan.getAttribute("data-price")) || 0;
                const itemTotal = qty * price;

                totalQty += qty;
                subtotal += itemTotal;

                thanhTienSpan.textContent = formatMoney(itemTotal);
            }
        });

        // Cập nhật lên UI
        const headerQty = document.getElementById("header-qty");
        const summaryQty = document.getElementById("summary-total-qty");
        const summaryTongThanhToan = document.getElementById("summary-tongthanhtoan");
        const btnDatHang = document.getElementById("btnDatHang");

        if (headerQty) headerQty.textContent = totalQty;
        if (summaryQty) summaryQty.textContent = totalQty;
        if (summaryTongThanhToan) summaryTongThanhToan.textContent = formatMoney(subtotal) + " VNĐ";
        if (btnDatHang) btnDatHang.setAttribute("data-final-total", subtotal);

        // Cập nhật cả widget giỏ hàng ngoài cột phải nếu có
        const sidebarAmount = document.querySelector(".pn-cart-amount");
        const sidebarQty = document.querySelector(".pn-cart-widget span.text-primary");
        if (sidebarAmount) sidebarAmount.innerHTML = `${formatMoney(subtotal)} <span class="fs-6 text-dark">vnđ</span>`;
        if (sidebarQty) sidebarQty.textContent = totalQty;
    }

    // 3. GỬI AJAX LƯU SỐ LƯỢNG MỚI VÀO SESSION SERVER TRONG CHỚP MẮT
    let ajaxTimer = null;
    function syncQuantityWithServer(ms, qty) {
        clearTimeout(ajaxTimer);
        ajaxTimer = setTimeout(function () {
            fetch(`/GioHang/CapNhatSoLuongAjax?ms=${ms}&soLuong=${qty}`, {
                method: "POST",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    const rowThanhTien = document.getElementById(`thanhtien-${ms}`);
                    if (rowThanhTien) rowThanhTien.textContent = formatMoney(data.itemThanhTien);
                    const summaryTongThanhToan = document.getElementById("summary-tongthanhtoan");
                    if (summaryTongThanhToan) summaryTongThanhToan.textContent = formatMoney(data.tamTinh) + " VNĐ";
                    const btnDatHang = document.getElementById("btnDatHang");
                    if (btnDatHang) btnDatHang.setAttribute("data-final-total", data.tamTinh);
                }
            })
            .catch(err => console.log("Auto-sync cart error:", err));
        }, 150);
    }

    // 4. XỬ LÝ SỰ KIỆN NÚT [+] VÀ [-]
    document.querySelectorAll(".btn-qty-plus").forEach(function (btn) {
        btn.addEventListener("click", function () {
            const ms = btn.getAttribute("data-ms");
            const input = document.querySelector(`input.input-cart-qty[data-ms='${ms}']`);
            if (input) {
                let currentVal = parseInt(input.value) || 1;
                if (currentVal < 99) {
                    input.value = currentVal + 1;
                    updateCartTotals();
                    syncQuantityWithServer(ms, input.value);
                }
            }
        });
    });

    document.querySelectorAll(".btn-qty-minus").forEach(function (btn) {
        btn.addEventListener("click", function () {
            const ms = btn.getAttribute("data-ms");
            const input = document.querySelector(`input.input-cart-qty[data-ms='${ms}']`);
            if (input) {
                let currentVal = parseInt(input.value) || 1;
                if (currentVal > 1) {
                    input.value = currentVal - 1;
                    updateCartTotals();
                    syncQuantityWithServer(ms, input.value);
                }
            }
        });
    });

    // 5. XỬ LÝ SỰ KIỆN KHI NGƯỜI DÙNG TỰ GÕ SỐ TRONG Ô INPUT
    document.querySelectorAll(".input-cart-qty").forEach(function (input) {
        input.addEventListener("input", function () {
            let val = parseInt(this.value);
            if (isNaN(val) || val < 1) val = 1;
            if (val > 99) val = 99;
            this.value = val;
            const ms = this.getAttribute("data-ms");
            updateCartTotals();
            syncQuantityWithServer(ms, val);
        });
    });

    // 6. XÁC NHẬN KHI BẤM NÚT ĐẶT HÀNG
    const formDatHang = document.getElementById("formDatHang");
    const btnDatHang = document.getElementById("btnDatHang");
    if (formDatHang && btnDatHang) {
        formDatHang.addEventListener("submit", function (e) {
            const finalTotal = btnDatHang.getAttribute("data-final-total") || "0";
            const confirmMsg = `Xác nhận đặt hàng với tổng số tiền thanh toán là ${formatMoney(finalTotal)} VNĐ?`;
            if (!confirm(confirmMsg)) {
                e.preventDefault();
            }
        });
    }
});
</script>
}
