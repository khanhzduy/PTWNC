@model BookOnline.ViewModels.CartSummaryViewModel

<div class="pn-cart-widget mb-3 shadow-sm">
    <a asp-controller="GioHang" asp-action="Index" class="text-decoration-none text-dark d-block">
        <div class="d-flex align-items-center mb-2 pb-2 border-bottom border-warning">
            <img src="/images/Sotien.gif" alt="Tiền" class="me-2" style="height: 24px;" onerror="this.src='/images/Upload/Sample.jpg'" />
            <div>
                <div class="small text-muted fw-semibold">Tổng thanh toán:</div>
                <div class="pn-cart-amount" id="sidebarCartAmount">
                    @Model.TongTien.ToString("#,##0") <span class="fs-6 text-dark">vnđ</span>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-1">
            <div class="d-flex align-items-center">
                <img src="/images/Giohang.gif" alt="Giỏ hàng" class="me-2" style="height: 22px;" onerror="this.src='/images/Upload/Sample.jpg'" />
                <span class="fw-bold text-secondary">Giỏ hàng: <span class="text-primary fs-6" id="sidebarCartQty">@Model.TongSoLuong</span> cuốn</span>
            </div>
            <span class="badge bg-primary rounded-pill px-2 py-1"><i class="bi bi-chevron-right"></i></span>
        </div>
    </a>
</div>
