@model IEnumerable<BookOnline.ViewModels.ChuDeViewModel>
@{
    var currentMcd = Context.Request.Query["mcd"].ToString();
}

<div class="card pn-chude-card mb-3 shadow-sm">
    <div class="card-header pn-chude-header d-flex align-items-center">
        <i class="bi bi-grid-3x3-gap-fill me-2 text-warning"></i>
        <span>DANH MỤC CHỦ ĐỀ SÁCH</span>
    </div>
    <div class="list-group list-group-flush">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                var isActive = (currentMcd == item.Mcd.ToString());
                <a asp-controller="Sach" asp-action="TheoChuDe" asp-route-mcd="@item.Mcd" 
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center pn-chude-item @(isActive ? "active" : "")">
                    <span class="text-truncate">
                        <i class="bi @(isActive ? "bi-check2-circle text-warning" : "bi-journal-bookmark text-primary") me-2"></i>
                        @item.TenChuDe
                    </span>
                    <span class="badge pn-badge-count">
                        @item.TongSoSach
                    </span>
                </a>
            }
        }
        else
        {
            <div class="p-3 text-muted small">Đang cập nhật danh mục...</div>
        }
    </div>
</div>
