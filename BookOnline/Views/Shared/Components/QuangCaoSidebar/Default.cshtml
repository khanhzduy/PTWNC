@model IEnumerable<BookOnline.Models.QuangCao>

<div class="card shadow-sm border-0 mb-3 bg-white" style="border-radius: 10px; border: 1px solid var(--pn-border);">
    <div class="card-header bg-white text-primary fw-bold small text-uppercase py-2 d-flex align-items-center justify-content-between border-bottom">
        <span><i class="bi bi-badge-ad-fill text-warning me-1"></i> VÙNG QUẢNG CÁO 2</span>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.68rem;">Còn thời hạn</span>
    </div>
    <div class="card-body p-2 d-flex flex-column gap-2">
        @if (Model != null && Model.Any())
        {
            @foreach (var ad in Model)
            {
                var rawImg = ad.HinhMinhHoa?.Trim() ?? "";
                if (!string.IsNullOrEmpty(rawImg) && !rawImg.Contains("."))
                {
                    rawImg += ".gif";
                }
                var adImg = string.IsNullOrEmpty(rawImg)
                    ? "/images/QC01.gif"
                    : (rawImg.StartsWith("/") ? rawImg : $"/images/Upload/{rawImg}");
                var link = string.IsNullOrWhiteSpace(ad.Href) ? "#" : ad.Href;

                <div class="p-2 rounded border bg-light shadow-sm">
                    <!-- 1. Tên công ty đối tác (TenCTy) & Mã quảng cáo (STT) -->
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="fw-bold text-dark small text-truncate" title="@ad.TenCty" style="max-width: 170px;">
                            <i class="bi bi-building text-primary me-1"></i>@(string.IsNullOrWhiteSpace(ad.TenCty) ? "Đối tác liên kết" : ad.TenCty)
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary small" style="font-size: 0.65rem;">#@ad.Stt</span>
                    </div>

                    <!-- 2. Hình ảnh banner (Hinh_Minh_Hoa) kèm liên kết chuyển hướng (HREF) -->
                    <a href="@link" target="_blank" rel="noopener noreferrer" class="d-block text-center rounded overflow-hidden mb-1" title="@ad.TenCty">
                        <img src="@adImg" alt="@ad.TenCty" class="img-fluid rounded" style="max-height: 75px; width: 100%; object-fit: contain; background: #fff;" onerror="this.src='/images/Upload/QC_BEN.png'" />
                    </a>

                    <!-- 3. Thời hạn quảng cáo (Ngay_het_han) & Link website (HREF) -->
                    <div class="d-flex align-items-center justify-content-between pt-1 border-top" style="font-size: 0.7rem;">
                        <span class="text-success fw-semibold" title="Bắt đầu: @(ad.NgayBatDau?.ToString("dd/MM/yyyy") ?? "N/A")">
                            <i class="bi bi-calendar-check me-1"></i>@(ad.NgayHetHan != null ? $"Hạn: {ad.NgayHetHan.Value:dd/MM/yyyy}" : "Vô thời hạn")
                        </span>
                        <a href="@link" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none fw-semibold small" title="Truy cập website đối tác">
                            Xem web <i class="bi bi-box-arrow-up-right small"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center p-3 text-muted small">Hiện chưa có banner quảng cáo còn hạn.</div>
        }
    </div>
</div>
